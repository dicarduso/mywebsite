---
---

<section id="contact" class="w-full py-12 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-md md:text-lg text-[#D12B18]">
      <span class="text-md md:text-lg font-mono text-[#F3705F]"><span class="text-[#D12B18] font-bold ml-6">$</span> write Diogo </span>
    </h2>
    <h3 class="text-4xl md:text-5xl font-medium text-[var(--white)] mb-6">
      Contact
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="text-[var(--white-icon)]">
        <div class="flex items-center gap-2">
          <span>Location:</span>
          <span class="text-[var(--white)]">Portugal</span>
        </div>
      </div>

      <div class="contact-card p-5 md:p-7">
        <div class="flex items-center justify-between gap-3 border-b border-[var(--white-icon-tr)] pb-4">
          <div>
            <h4 class="text-lg font-medium text-white">Send a message</h4>
          </div>
          <span class="hidden rounded-full border border-emerald-400/20 bg-emerald-400/10 px-2.5 py-1 font-mono text-[10px] text-emerald-300 sm:inline">
            open
          </span>
        </div>

        <form
          id="contact-form"
          action="https://formspree.io/f/xjyywjyq"
          method="POST"
          class="mt-5 flex flex-col gap-4"
        >
          <input
            type="hidden"
            name="_subject"
            value="New message from darkminimal portfolio"
          />
          <div
            class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden"
            aria-hidden="true"
          >
            <label for="_gotcha">Leave this field empty</label>
            <input
              id="_gotcha"
              type="text"
              name="_gotcha"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="from_name" class="contact-label">Your name</label>
              <input
                id="from_name"
                type="text"
                name="from_name"
                placeholder="Ada Lovelace"
                required
                autocomplete="name"
                class="contact-field"
              />
            </div>
            <div>
              <label for="reply_to" class="contact-label">Your email</label>
              <input
                id="reply_to"
                type="email"
                name="reply_to"
                placeholder="you@example.com"
                required
                autocomplete="email"
                class="contact-field"
              />
            </div>
          </div>

          <div>
            <label for="subject" class="contact-label">Subject</label>
            <input
              id="subject"
              type="text"
              name="subject"
              placeholder="Role, project, or research question"
              class="contact-field"
            />
          </div>

          <div>
            <label for="message" class="contact-label">Message</label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              placeholder="Tell me what you have in mind…"
              class="contact-field resize-none"
            ></textarea>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <button type="submit" class="btn btn-primary group" data-submit>
              Send message
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                aria-hidden="true"
              >
                <path d="M7 17 17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </button>
          </div>

          <p
            id="form-status"
            role="status"
            aria-live="polite"
            class="min-h-[1.25rem] text-xs leading-relaxed"
          ></p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");
  const submit = document.querySelector<HTMLButtonElement>("[data-submit]");

  const setStatus = (message: string, tone: "ok" | "error" | "idle") => {
    if (!status) return;

    status.textContent = message;
    status.classList.remove(
      "text-emerald-300",
      "text-red-300",
      "text-[var(--white-icon)]"
    );
    status.classList.add(
      tone === "ok"
        ? "text-emerald-300"
        : tone === "error"
          ? "text-red-300"
          : "text-[var(--white-icon)]"
    );
  };

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const data = new FormData(form);
    const original = submit?.innerHTML;

    if (submit) {
      submit.disabled = true;
      submit.textContent = "Sending…";
    }

    setStatus("Sending your message…", "idle");

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: data,
        headers: { Accept: "application/json" },
      });

      if (!response.ok) throw new Error("Request failed");

      form.reset();
      setStatus(
        "Message sent. Thanks — I usually reply within one or two days.",
        "ok"
      );
    } catch {
      setStatus(
        "Something went wrong. Please email dicarduso@protonmail.com directly.",
        "error"
      );
    } finally {
      if (submit) {
        submit.disabled = false;
        submit.innerHTML = original ?? "Send message";
      }
    }
  });
</script>
