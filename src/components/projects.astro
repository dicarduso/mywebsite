---
import Icon from "./Icon.astro";
import TechStack from "./TechStack.astro";
import { withBase } from "../utils/base";

interface ProjectCover {
  variant: string;
  icon: string;
}

interface Project {
  title: string;
  subtitle: string;
  image?: string;
  link: string;
  preview: string;
  status: string;
  category: string;
  year: string;
  summary: string;
  technologies: string[];
  cover: ProjectCover;
}

const projects: Project[] = [
  {
    title: "London's transport schedule predictive AI Model",
    subtitle:
      "Streaming TfL line-status forecasts with continuous learning presented on a live dashboard.",
    image: "/projects/london-metro.jpg",
    link: "https://github.com/dicarduso/",
    preview: "/london-api-predicting-model",
    status: "Concluded",
    category: "Data Science",
    year: "2026",
    summary:
       "A Machine Learning pipeline built with CapyMoa operating on a 30-second ingestion loop, feeding two adaptive random forests, to score 15, 30, 45, and 60-minute disruption horizons. Redis acts as a low-latency communication system transmiting streaming data between the components, and Streamlit displays a live Dashboard with the forecasts on multiple lines.",
    technologies: ["Python", "CapyMOA", "Redis", "Streamlit", "TfL API"],
    cover: {
      variant: "london",
      icon: "train",
    },
  },
  {
    title: "CTT's Bank Phishing Kit analysis",
    subtitle:
      "Reverse-engineering a real phishing kit, uncovering all it's functions.",
    image: "/projects/ctt-phish.jpeg",
    link: "https://github.com/dicarduso/",
    preview: "/ctt-bank-phishing-kit-analysis",
    status: "Concluded",
    category: "Cyber Security",
    year: "2026",
    summary:
      "A documented analysis of a real phishing kit impersonating Portugal's bank CTT.Deobfuscation and explanation of every function on the malicious JavaScript code (fingerprinting, obfuscation and deobfuscation, AES-encryption, DOM manipulation, etc )",
    technologies: ["JavaScript", "Burp Suite", "HTML", "Webcrack"],
    cover: {
      variant: "ctt",
      icon: "shield",
    },
  },
  {
    title: "Hack The Box Walkthrough",
    subtitle:
      "Hack the box write-up of a retired machine.",
    link: "https://github.com/dicarduso/",
    preview: "/htb-walkthrough",
    status: "Ongoing",
    category: "Cyber Security",
    year: "2026",
    summary:
      "Hack the box write-up of a retired machine.",
    technologies: [""],
    cover: {
      variant: "htb",
      icon: "terminal",
    },
  },
];

const statusStyles: Record<string, string> = {
  Concluded: "border-emerald-400/25 bg-emerald-400/10 text-emerald-300",
  Ongoing: "border-sky-400/25 bg-sky-400/10 text-sky-300",
};

const isExternal = (href: string) => href.startsWith("http");
---

<section
  id="projects"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <p class="text-md md:text-lg font-mono text-[#F3705F]"><span class="text-[#D12B18] font-bold ml-6">$</span> cd Projects
    </p>

    <div class="mt-2 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <h3 class="text-4xl md:text-5xl font-medium">Projects</h3>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-[var(--white-icon)]">
          Explore my work across data science and cyber security. 
        </p>
          <p class="mt-2 max-w-xl text-sm leading-relaxed text-[#F3705F]"> Hover a card to read the descritpion of each project.
        </p>
      </div>
      <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--white-icon)]">
        {projects.length} projects
      </span>
    </div>

    <div class="mt-8 flex flex-col items-stretch gap-6 md:flex-row">
      {
        projects.map((project) => (
          <article
            class="project-card group relative flex h-full min-w-0 flex-col overflow-hidden rounded-2xl border border-white/[0.08] bg-[#0a0a0a] transition-[flex-grow,border-color,box-shadow] duration-300 ease-out hover:border-[#D12B18]/50 hover:shadow-[0_24px_70px_-36px_rgba(209, 43, 24,0.55)] md:basis-0 md:grow md:hover:z-10 md:hover:grow-[2]"
          >
            <a
              href={withBase(project.preview)}
              target={isExternal(project.preview) ? "_blank" : undefined}
              rel={isExternal(project.preview) ? "noopener noreferrer" : undefined}
              class="relative block aspect-[16/10] overflow-hidden"
              aria-label={`${project.title} — open project`}
            >
              {project.image ? (
                <img
                src={withBase(project.image)}
                alt=""
                class="project-image h-full w-full scale-[1.18] object-cover transition-[transform,filter] duration-500 ease-out group-hover:scale-100 group-hover:blur-[3px]"
                loading="lazy"
                decoding="async"
            />
              ) : (
                <div
                  class={`project-cover project-cover--${project.cover.variant} relative h-full w-full scale-[1.18] transition-transform duration-500 ease-out group-hover:scale-100`}
                >
                  <div class="project-cover-grid absolute inset-0 opacity-[0.16]" />
                  <div class="absolute -right-8 -top-8 h-32 w-32 rounded-full border border-white/10" />
                  <div class="absolute -right-2 -top-2 h-20 w-20 rounded-full border border-white/[0.07]" />
                </div>
              )}

              <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/35 to-black/10" />

              <div class="absolute inset-x-0 top-0 flex items-start justify-between gap-3 p-4 transition-opacity duration-300 group-hover:opacity-0 group-hover:pointer-events-none">
                <div class="flex flex-wrap gap-1.5">
                  <span
                    class={`rounded-full border px-2.5 py-0.5 text-[10px] font-medium ${statusStyles[project.status] ?? "border-white/15 bg-black/40 text-white/70"}`}
                  >
                    {project.status}
                  </span>
                  <span class="rounded-full border border-white/10 bg-black/40 px-2.5 py-0.5 text-[10px] text-white/70">
                    {project.category}
                  </span>
                </div>
                <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-white/50">
                  {project.year}
                </span>
              </div>

              <div class=" absolute inset-x-0 bottom-0 p-4 ">
                <div class="flex items-center gap-2 font-mono text-[10px] text-white/55 transition-opacity duration-300 group-hover:opacity-0">
                  <span class="flex h-8 w-8 items-center justify-center rounded-lg border border-white/15 bg-white/[0.06] text-white/85">
                    <Icon name={project.cover.icon} size={15} />
                    </span>
                </div>

                <p class="mt-3 grid grid-rows-[0fr] opacity-0 transition-all duration-300 ease-out group-hover:grid-rows-[1fr] group-hover:opacity-100">
                  <span class="overflow-hidden text-[13px] leading-relaxed text-white/80">
                    {project.summary}</span>
                    </p>
              </div>
            </a>

            <div class="flex flex-1 flex-col p-5">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h4 class="text-xl font-semibold leading-snug transition-colors group-hover:text-[#F3705F]">
                    <a
                      href={withBase(project.preview)}
                      target={isExternal(project.preview) ? "_blank" : undefined}
                      rel={isExternal(project.preview) ? "noopener noreferrer" : undefined}
                      class="outline-none focus-visible:underline"
                    >
                      {project.title}
                    </a>
                  </h4>
                  <p class="mt-1.5 text-sm leading-relaxed text-[var(--white-icon)]">
                    {project.subtitle}
                  </p>
                </div>

                <a
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${project.title} on GitHub`}
                  class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/[0.02] text-[var(--white-icon)] transition-colors hover:border-[#D12B18]/50 hover:text-white"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="h-4 w-4"
                    aria-hidden="true"
                  >
                    <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z" />
                  </svg>
                </a>
              </div>

              <TechStack technologies={project.technologies} />

              <div class="mt-4 flex items-center justify-between gap-3 border-t border-white/[0.07] pt-4">
                <a
                  href={withBase(project.preview)}
                  target={isExternal(project.preview) ? "_blank" : undefined}
                  rel={isExternal(project.preview) ? "noopener noreferrer" : undefined}
                  class="inline-flex items-center gap-1.5 text-xs font-medium text-[var(--white)] transition-colors hover:text-[#F3705F]"
                >
                  Open project
                  <Icon
                    name="arrow-right"
                    size={14}
                    class="transition-transform group-hover:translate-x-0.5"
                  />
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <a
      target="_blank"
      href="https://github.com/dicarduso/"
      aria-label="GitHub"
      class="w-full flex items-center justify-center gap-2 mt-9 text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr-button)] hover:scale-105"
    >
      <span class="md:text-lg text-md">More projects on</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="size-6"
      >
        <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"></path>
      </svg>
    </a>
  </div>
</section>

