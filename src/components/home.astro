---
import LetterGlitch from "../React/LetterGlitch.tsx";
import LogoWall from "../components/logoWall.astro";
import SkillsList, {skills} from "../React/SkillsList.tsx";
import EmailModal from "./EmailModal.astro";
import Icon from "./Icon.astro";
import { site } from "../data/site.ts";
---

<section class="text-[var(--white)] mt-12 md:mt-0" id="home">
    
    <div class="max-w-5xl mx-auto space-y-8 md:py-36 pb-14">
    <div class="grid items-start gap-12 lg:grid-cols-[1.08fr_0.92fr] lg:gap-16">
      
      <!-- LADO ESQUERDO: O teu Texto, Badge e Botões -->
      <div class="max-w-2xl space-y-6">
        
        <!-- Badge -->
        <div class="reveal inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-1.5 text-[11px] font-medium tracking-wide text-muted">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-pulse-ring rounded-full bg-emerald-400"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
          </span>
          {site.availability}
        </div>

        <!-- Terminal Whoami -->
        <p class="text-md md:text-lg font-mono text-[#F3705F]"><span class="text-[#D12B18] font-bold ml-6">$</span> whoami<span class="ml-0.5 inline-block h-4 w-2 translate-y-0.5 animate-blink bg-[#D12B18]/80 align-middle"></span>
        </p>


        <!-- O Teu Nome -->
        <h1 class="text-[var(--white)] hover:text-[var(--white-icon-tr-button)] transition-colors duration-300 text-8xl md:text-10xl font-bold text-pretty leading-none cursor-pointer">
          Diogo Cardoso
        </h1>

        <!-- Data Scientist → Cyber Security -->
        <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-lg font-light text-[var(--white)] md:text-xl">
          <span>Data Scientist</span>
          <span class="text-[#D12B18]" aria-hidden="true">→</span>
          <span>Cyber Security</span>
        </p>

        <!-- Botões principais -->
        <div class="flex flex-wrap items-center gap-3 pt-4">
          <a href="/#projects" class="btn btn-primary group">
            View selected work
            <Icon
              name="arrow-right"
              size={16}
              class="transition-transform group-hover:translate-x-0.5"
            />
          </a>
          <a href="#about" class="btn btn-ghost">
            <Icon name="shield" size={16} class="text-[#F3705F]" />
            About me
          </a>
        </div>

        <!-- Os teus Botões Sociais -->
        <div class="flex justify-start gap-3 pt-4">
          <a target="_blank" rel="noopener noreferrer" href="https://github.com/dicarduso/" aria-label="GitHub" class="text-[var(--white-icon)] hover:text-[var(--white)] transition duration-300 ease-in-out p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr-button)]">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-8">
              <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"></path>
            </svg>
          </a>
          <a target="_blank" rel="noopener noreferrer" href="https://www.linkedin.com/in/diogo-cardoso-262648430/" aria-label="LinkedIn" class="text-[var(--white-icon)] hover:text-[var(--white)] transition duration-300 ease-in-out p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr-button)]">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-8">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <button type="button" data-email-trigger aria-label="Email" class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr-button)] cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" width="2.1em" height="2.1em" viewBox="0 0 24 24">
              <path fill="currentColor" d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- LADO DIREITO: O Terminal com LetterGlitch -->
      <div class="relative flex flex-col w-full h-full min-h-[350px] lg:min-h-[450px] max-w-md lg:max-w-none overflow-hidden rounded-[1.75rem] border border-white/10 bg-black/20 shadow-2xl">
        
        <!-- Cabeçalho do Terminal -->
        <div class="relative z-20 flex items-center justify-between border-b border-white/10 bg-[#0a0a0a] px-4 py-3">
          <div class="flex items-center gap-1.5" aria-hidden="true">
            <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
            <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
            <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
          </div>
          <span class="font-mono text-[10px] tracking-wide text-white/45">diogo@portfolio: ~/profile</span>
          <span class="font-mono text-[10px] text-emerald-400/80">● live</span>
        </div>

        <!-- Corpo do Terminal (Espaço para a animação) -->
        <div class="relative z-10 w-full flex-1 bg-black">
          <div class="absolute inset-0">
            <LetterGlitch
              client:load
              glitchColors={["#ff040463", "#fa261f", "#000000"]}
              glitchSpeed={33}
              centerVignette={false}
              outerVignette={true}
              smooth={true}
            />
            </div>
          </div>
        </div>

      </div>
    </div>
</section>

<EmailModal />
