---
const email = "dicarduso@protonmail.com";
---

<!--
  Email pop-up. Render this component ONCE per page (it is included in home.astro).
  Any element with the attribute `data-email-trigger` opens it (home + footer icons).
-->
<div id="email-modal" class="email-overlay" aria-hidden="true">
  <div
    class="email-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="email-modal-title"
    tabindex="-1"
  >
    <button type="button" class="email-close" data-email-close aria-label="Close">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="22" height="22">
        <path d="M11.9997 10.5865L16.9495 5.63672L18.3637 7.05093L13.4139 12.0007L18.3637 16.9504L16.9495 18.3646L11.9997 13.4149L7.04996 18.3646L5.63574 16.9504L10.5855 12.0007L5.63574 7.05093L7.04996 5.63672L11.9997 10.5865Z"></path>
      </svg>
    </button>

    <h2 id="email-modal-title" class="email-title">Email</h2>
    <a class="email-address" href={`mailto:${email}`}>{email}</a>
    <button type="button" class="email-copy" data-email-copy data-email={email}>
      Copy
    </button>
  </div>
</div>

<script>
  const modal = document.getElementById("email-modal");

  if (modal) {
    const dialog = modal.querySelector<HTMLElement>(".email-dialog")!;
    const copyBtn = modal.querySelector<HTMLButtonElement>("[data-email-copy]")!;
    let lastFocused: HTMLElement | null = null;

    const open = (trigger: HTMLElement) => {
      lastFocused = trigger;
      modal.classList.add("is-open");
      modal.setAttribute("aria-hidden", "false");
      document.documentElement.style.overflow = "hidden";
      dialog.focus();
    };

    const close = () => {
      modal.classList.remove("is-open");
      modal.setAttribute("aria-hidden", "true");
      document.documentElement.style.overflow = "";
      lastFocused?.focus();
    };

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const trigger = target.closest<HTMLElement>("[data-email-trigger]");
      if (trigger) {
        e.preventDefault();
        open(trigger);
        return;
      }
      if (target === modal || target.closest("[data-email-close]")) close();
    });

    document.addEventListener("keydown", (e) => {
      if (!modal.classList.contains("is-open")) return;
      if (e.key === "Escape") close();
      if (e.key === "Tab") {
        // keep keyboard focus inside the pop-up
        const focusable = Array.from(
          dialog.querySelectorAll<HTMLElement>("button, a[href]")
        );
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    copyBtn.addEventListener("click", async () => {
      const email = copyBtn.dataset.email ?? "";

      try {
        await navigator.clipboard.writeText(email);
        copyBtn.textContent = "Copied!";
      } catch {
        // Fallback for browsers/contexts where the Clipboard API is blocked.
        const field = document.createElement("textarea");
        field.value = email;
        field.setAttribute("readonly", "");
        field.style.position = "fixed";
        field.style.opacity = "0";
        document.body.appendChild(field);
        field.select();
        const copied = document.execCommand("copy");
        document.body.removeChild(field);
        copyBtn.textContent = copied ? "Copied!" : "Press Ctrl+C";
      }

      setTimeout(() => (copyBtn.textContent = "Copy"), 1500);
    });
  }
</script>
