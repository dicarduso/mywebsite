---
import Icon from "@/components/Icon.astro";
import { site } from "@/data/site";

const facts = [
  { icon: "map-pin", label: "Based in", value: site.location },
  { icon: "target", label: "Focus", value: "Web penetration testing" },
  { icon: "graduation-cap", label: "Education", value: "Data Science graduate" },
  { icon: "globe", label: "Languages", value: "Portuguese · English" },
] as const;

const principles = [
  {
    icon: "chart",
    title: "Data Science",
    body: "Data manipulation. Behavior's prediciton.",
  },
  {
    icon: "target",
    title: "Hacking",
    body: "Infiltrating systems. Finding weaknesses",
  }
] as const;
---

<section id="about" class="w-full scroll-mt-28 border-t border-[#ffffff10] py-12 text-[var(--white)]">
  <div class="mx-auto max-w-5xl">
    <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div>
        <p>
        <span class="text-md md:text-lg font-mono text-[#F3705F]"><span class="text-[#D12B18] font-bold ml-6">$</span> cat about.txt</span>
        </p>
        <h1 class="mt-4 text-4xl font-medium leading-tight md:text-5xl">
          From Data Science,<br />
          to <span class="text-[#F3705F]"> Cyber Security.</span>
        </h1>

        <div class="mt-8 rounded-2xl border border-white/10 bg-white/[0.02] p-5">
          <div class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--white-icon)]">
            <span class="h-1.5 w-1.5 rounded-full bg-[#D12B18]"></span>
            current goal
          </div>
          <p class="mt-3 text-sm leading-relaxed text-[#dfdfdf]/75">
            Prepare to earn the BSCP Portswigger certification.
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            <span class="rounded-full border border-white/10 bg-white/[0.02] px-3 py-1 font-mono text-[10px] text-[var(--white-icon)]">Portswigger </span>
            <span class="rounded-full border border-white/10 bg-white/[0.02] px-3 py-1 font-mono text-[10px] text-[var(--white-icon)]">Hackthebox</span>
            <span class="rounded-full border border-white/10 bg-white/[0.02] px-3 py-1 font-mono text-[10px] text-[var(--white-icon)]">Burpsuite</span>
          </div>
        </div>

        <dl class="mt-8 grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 sm:grid-cols-2">
          {
            facts.map((fact) => (
              <div class="flex items-start gap-3 bg-[#0a0a0a] p-4">
                <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-[#F3705F]">
                  <Icon name={fact.icon} size={15} />
                </span>
                <div>
                  <dt class="font-mono text-[10px] uppercase tracking-[0.15em] text-[var(--white-icon)]">
                    {fact.label}
                  </dt>
                  <dd class="mt-0.5 text-sm text-[var(--white)]">{fact.value}</dd>
                </div>
              </div>
            ))
          }
        </dl>

      </div>

      <div>
        <div class="space-y-5 text-[15px] leading-[1.8] text-[var(--white-icon)] md:text-base">
          <p>
            Started in Data Science by an interest in a field capable of identifying patterns
            and predicting behavior accross all areas of life (sports, industries, economy, politics, etc). 
            That interest grew after getting in touch with projects that found solutions, using statistical
            and Machine Learning methods, for real problems faced in practical, everyday scenarios. I came to understand
            the power of data in the modern world, and the capabilities of those who know how to work with it.

          </p>
          <p>
            That curiosity in data manipulation led me to <span class="text-[#D12B18]">Cyber Security</span>. 
            After getting involved in multiple data science and computer science events, 
            I came to realize that not only data manipulation is a really powerful skill, when mixed with the capacity of accessing
            sensitive data of big tech companies, leads to a tremendously powerful skill-set.
            I participated in multiple cyber security workshops, and loved it.
          </p>
          <p>
            What hooked me the most was the creativity one has to have to find unorthodox paths towards finding a weakness on a website.
            While learning about the different types of web attacks (CSRF, CORS, SQL injection, Brute-Force attacks, XSS), I found the dynamic
            of a hacker even more interesting than that of a Data Scientist.
            I've Been learning and practicing my hacking skills ever since.
          </p>
        </div>

        <div class="mt-8 grid gap-3 sm:grid-cols-3">
          {
            principles.map((item) => (
              <div class="rounded-xl border border-white/[0.08] bg-white/[0.015] p-4 transition-colors hover:border-[#D12B18]/30">
                <Icon name={item.icon} size={17} class="text-[#F3705F]" />
                <h2 class="mt-3 text-sm font-medium text-[var(--white)]">{item.title}</h2>
                <p class="mt-1.5 text-xs leading-relaxed text-[var(--white-icon)]">{item.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
