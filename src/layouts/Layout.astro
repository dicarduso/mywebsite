---
import '@fontsource/ubuntu/400.css'; 
import '@fontsource/ubuntu/700.css'; 
import '../styles/global.css';
import { withBase } from '../utils/base';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title} | Portfolio</title>
    <meta
      name="description"
      content="Diogo Cardoso - Data Scientist graduate and Cyber Security enthusiast."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={withBase("/favicon.png")} />
    <link rel="canonical" href="https://darkminimal.vercel.app/" />

    <meta
      property="og:title"
      content="Diogo Cardoso | Cyber Security"
    />
    <meta
      property="og:description"
      content="Website of Diogo Cardoso, a Data Scientist moving his area to Cyber Security."
    />
    <meta
      property="og:image"
      content="https://darkminimal.vercel.app/og.image.png"
    />
    <meta property="og:url" content="https://darkminimal.vercel.app" />
    <meta property="og:type" content="website" />
    <meta
      property="og:site_name"
      content="Diogo Cardoso's website"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Diogo Cardoso",
        "url": "https://darkminimal.vercel.app",
        "image": "https://darkminimal.vercel.app/og.image.png",
        "sameAs": [
          "https://github.com",
          "https://linkedin.com"
        ],
        "jobTitle": "Data Scientist & Cyber Security Enthusiast",
        "description": "Data Scientist graduate transitioning into Cyber Security."
      }
    </script>
  </head>
  <body
    class="bg-[--background] sm:px-28 lg:px-20 px-9"
    style={`--cursor-def: url('${withBase("/cursor-def.png")}'); --cursor-click: url('${withBase("/cursor-click.png")}');`}
  >
    <slot />
  </body>
</html>

