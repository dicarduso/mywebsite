---
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import PhishingGraph from "@/React/PhishingGraph.tsx";
import analysisData from "@/data/phishing-analysis.json";
import { withBase } from "@/utils/base";

type GraphNode = {
  id: string;
  label: string;
  type?: string;
  category?: string;
  impact?: string;
  description?: string;
  code?: string;
  children?: GraphNode[];
};

const root = (analysisData as { obfuscated: GraphNode }).obfuscated;
const leaves: GraphNode[] = [];

const collectLeaves = (node: GraphNode) => {
  if (node.type === "leaf") leaves.push(node);
  node.children?.forEach(collectLeaves);
};

collectLeaves(root);

const categories = root.children ?? [];
const criticalCount = leaves.filter((leaf) => leaf.impact === "Critical").length;
const highCount = leaves.filter((leaf) => leaf.impact === "High").length;

const findings = [
  {
    icon: "shield",
    severity: "High",
    title: "Cloaked delivery",
    body: "User-agent, referrer, and geo checks decide who sees the kit. Scanners and researchers are quietly redirected to the real CTT site.",
  },
  {
    icon: "code",
    severity: "Medium",
    title: "Runtime loader",
    body: "The harvesting logic is decoded from Base64 and hexadecimal at runtime, so it never appears as plain text in the page source.",
  },
  {
    icon: "terminal",
    severity: "Critical",
    title: "Telegram exfiltration",
    body: "Card data and SMS codes are posted to a Telegram bot in near real time, replacing the traditional command-and-control server.",
  },
] as const;

---

<Layout title="CTT Bank Phishing Kit Analysis">
  <main class="mx-auto max-w-5xl py-16 text-[var(--white)] md:py-24">
    <a
      href={withBase("/#projects")}
      class="inline-flex items-center gap-2 font-mono text-m text-[#D12B18] transition-colors hover:text-[#F3705F]"
    >
      <Icon name="arrow-left" size={16} />
      Back to projects
    </a>

    <header class="mt-8">
      <div class="flex flex-wrap items-center gap-2">
        <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--white-icon)]">
          Cyber Security · 2026
        </span>
      </div>

      <h1 class="mt-4 max-w-3xl text-4xl font-bold leading-tight md:text-6xl">
        Analysis of a CTT bank phishing kit.
      </h1>

      <p class="mt-4 max-w-2xl text-base leading-relaxed text-[var(--white-icon)] md:text-lg">
        A documented analysis of a real phishing kit impersonating Portugal's bank CTT, where you can find the analysis of commonly used headers on 
        phishing kits and other HTML elements in this case study. Aswell as the deobfuscation and explanation of every function 
        on the malicious JavaScript code (fingerprinting, obfuscation and deobfuscation, AES encryption, DOM manipulation, etc ).
      </p>

      <div class="mt-6 flex flex-wrap gap-2">
        {
          ["Malware analysis", "Obfuscated Javascript",  "Webcrack", "Burp Suite", "HTML"].map((tag) => (
            <span class="rounded-full border border-white/10 bg-white/[0.02] px-3 py-1 font-mono text-[10px] text-[var(--white-icon)]">
              {tag}
            </span>
          ))
        }
      </div>
    </header>

    {/* Project partners — fill in the three hrefs/names when ready. */}
    <section class="mt-8 rounded-2xl border border-white/[0.08] bg-[#0a0a0a] p-5">
      <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-[#F3705F]">
        Project partners
      </p>
      <div class="mt-3 flex flex-wrap gap-3">
        {[
          { name: "Partner 1", href: "#" },
          { name: "Partner 2", href: "#" },
          { name: "Partner 3", href: "#" },
        ].map((partner) => (
          <a
            href={partner.href}
            class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.02] px-4 py-2 font-mono text-xs text-white/80 transition-colors hover:border-[#D12B18]/50 hover:text-white"
          >
            {partner.name}
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-14">
      <h2 class="mt-2 text-3xl font-medium md:text-4xl">
        The conceptmap of the attack.
      </h2>
      <p class="mt-3 max-w-2xl text-m leading-relaxed text-[var(--white-icon)]">
        Pick one of the two analysis blocks below — the landing page's HTTP
        headers and HTML structure, or the obfuscated payload. Inside the
        payload you can read the complete obfuscated file against its
        deobfuscated twin, or explore the kit function by function.
      </p>

      <div class="mt-6">
        <PhishingGraph client:load />
      </div>
    </section>

    <div class="mt-14 border-t border-white/10 pt-8">
      <a
        href={withBase("/#projects")}
        class="inline-flex items-center gap-2 text-m text-[var(--white-icon)] transition-colors hover:text-white"
      >
        <Icon name="arrow-left" size={15} />
        Back to all projects
      </a>
    </div>
  </main>
</Layout>
