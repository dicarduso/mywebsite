---
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import PhishingGraph from "@/React/PhishingGraph.tsx";
import analysisData from "@/data/phishing-analysis.json";

type GraphNode = {
  id: string;
  label: string;
  type?: string;
  category?: string;
  impact?: string;
  description?: string;
  code?: string;
  children?: GraphNode[];
};

const root = analysisData as GraphNode;
const leaves: GraphNode[] = [];

const collectLeaves = (node: GraphNode) => {
  if (node.type === "leaf") leaves.push(node);
  node.children?.forEach(collectLeaves);
};

collectLeaves(root);

const categories = root.children ?? [];
const criticalCount = leaves.filter((leaf) => leaf.impact === "Critical").length;
const highCount = leaves.filter((leaf) => leaf.impact === "High").length;

const findings = [
  {
    icon: "shield",
    severity: "High",
    title: "Cloaked delivery",
    body: "User-agent, referrer, and geo checks decide who sees the kit. Scanners and researchers are quietly redirected to the real CTT site.",
  },
  {
    icon: "code",
    severity: "Medium",
    title: "Runtime loader",
    body: "The harvesting logic is decoded from Base64 and hexadecimal at runtime, so it never appears as plain text in the page source.",
  },
  {
    icon: "terminal",
    severity: "Critical",
    title: "Telegram exfiltration",
    body: "Card data and SMS codes are posted to a Telegram bot in near real time, replacing the traditional command-and-control server.",
  },
] as const;

---

<Layout title="CTT Bank Phishing Kit Analysis">
  <main class="mx-auto max-w-5xl py-16 text-[var(--white)] md:py-24">
    <a
      href="/#projects"
      class="inline-flex items-center gap-2 font-mono text-sm text-[#D12B18] transition-colors hover:text-[#F3705F]"
    >
      <Icon name="arrow-left" size={16} />
      Back to projects
    </a>

    <header class="mt-8">
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-full border border-[#D12B18]/30 bg-[#D12B18]/10 px-2.5 py-0.5 text-[10px] font-medium text-[#F3705F]">
          Case study
        </span>
        <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--white-icon)]">
          Cyber Security · 2025
        </span>
      </div>

      <h1 class="mt-4 max-w-3xl text-4xl font-bold leading-tight md:text-6xl">
        Anatomy of a CTT bank phishing kit.
      </h1>

      <p class="mt-4 max-w-2xl text-base leading-relaxed text-[var(--white-icon)] md:text-lg">
        A live kit impersonating Portugal's postal service used User-Agent
        cloaking, a Base64 loader, and a Telegram bot to steal card data and SMS
        codes. This is the shorter teardown: what it does, how it hides, and what
        defenders can look for.
      </p>

      <div class="mt-6 flex flex-wrap gap-2">
        {
          ["Cyber Security", "Malware analysis", "2025"].map((tag) => (
            <span class="rounded-full border border-white/10 bg-white/[0.02] px-3 py-1 font-mono text-[10px] text-[var(--white-icon)]">
              {tag}
            </span>
          ))
        }
      </div>

      <div class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 sm:grid-cols-4">
        {
          [
            { value: String(leaves.length), label: "behaviours mapped" },
            { value: String(categories.length), label: "analysis categories" },
            { value: String(criticalCount), label: "critical findings" },
            { value: String(highCount), label: "high-impact findings" },
          ].map((stat) => (
            <div class="bg-[#0a0a0a] px-4 py-3">
              <p class="font-mono text-2xl font-medium text-white">{stat.value}</p>
              <p class="mt-0.5 text-[9px] uppercase tracking-[0.14em] text-[var(--white-icon)]">
                {stat.label}
              </p>
            </div>
          ))
        }
      </div>
    </header>

    <section class="mt-14">
      <p class="font-mono text-sm text-[#D12B18]">
        <span class="font-bold">$</span> cat overview.md
      </p>
      <h2 class="mt-2 text-3xl font-medium md:text-4xl">What the kit does.</h2>

      <div class="mt-4 space-y-4 text-sm leading-relaxed text-[var(--white-icon)]">
        <p>
          Phishing kits sit at the intersection of social engineering and software
          engineering. The user-facing part is designed to be believable; the
          machine-facing part is designed to be boring to analyse, expensive to
          block, and easy to redeploy.
        </p>
        <p>
          This sample was recovered during a campaign impersonating{" "}
          <span class="text-[var(--white)]">CTT</span>, the Portuguese postal
          operator. The lure is familiar: a parcel is held, a small fee is due,
          and the recipient is asked to confirm their details. What makes the kit
          worth documenting is how much effort went into not being seen.
        </p>
        <p>
          The analysis combines static reading of the payload with a controlled
          detonation in an isolated browser profile. Tokens, identifiers, and
          domains are redacted or defanged. No live victim data is included.
        </p>
      </div>

      <div class="mt-6 rounded-2xl border-l-2 border-[#D12B18] bg-white/[0.02] px-5 py-4">
        <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-[#F3705F]">
          In one paragraph
        </p>
        <p class="mt-2 text-sm leading-relaxed text-white/80">
          The kit profiles every visitor before deciding whether to show a fake CTT
          form. Clean Portuguese consumer traffic gets a multi-step credential
          form; scanners get the real CTT website. Stolen values are validated in
          the browser and forwarded to a Telegram bot.
        </p>
      </div>
    </section>

    <section class="mt-14">
      <p class="font-mono text-sm text-[#D12B18]">
        <span class="font-bold">$</span> grep findings
      </p>
      <h2 class="mt-2 text-3xl font-medium md:text-4xl">
        Three findings that matter.
      </h2>

      <div class="mt-6 grid gap-3 sm:grid-cols-3">
        {
          findings.map((finding) => (
            <div class="rounded-2xl border border-white/[0.08] bg-[#0a0a0a] p-5">
              <div class="flex items-center justify-between gap-3">
                <span class="flex h-9 w-9 items-center justify-center rounded-lg border border-[#D12B18]/25 bg-[#D12B18]/10 text-[#F3705F]">
                  <Icon name={finding.icon} size={17} />
                </span>
                <span
                  class={`rounded-full border px-2.5 py-0.5 font-mono text-[10px] ${
                    finding.severity === "Critical"
                      ? "border-red-500/30 bg-red-500/10 text-red-300"
                      : "border-orange-500/30 bg-orange-500/10 text-orange-300"
                  }`}
                >
                  {finding.severity}
                </span>
              </div>
              <h3 class="mt-3 text-sm font-medium text-white">{finding.title}</h3>
              <p class="mt-1.5 text-xs leading-relaxed text-[var(--white-icon)]">
                {finding.body}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-14">
      <p class="font-mono text-sm text-[#D12B18]">
        <span class="font-bold">$</span> tree attack-surface
      </p>
      <h2 class="mt-2 text-3xl font-medium md:text-4xl">
        The attack surface, mapped.
      </h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-[var(--white-icon)]">
        Expand a category and select a leaf to read the description, the
        defensive angle, and the original and deobfuscated code from the sample.
      </p>

      <div class="mt-6">
        <PhishingGraph client:load />
      </div>
    </section>

    <div class="mt-14 flex flex-col gap-3 border-t border-white/10 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <a
        href="/#projects"
        class="inline-flex items-center gap-2 text-sm text-[var(--white-icon)] transition-colors hover:text-white"
      >
        <Icon name="arrow-left" size={15} />
        Back to all projects
      </a>
      <a
        href="/#contact"
        class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.03] px-4 py-2 text-sm text-[var(--white)] transition-colors hover:border-[#D12B18]/50 hover:text-white"
      >
        Discuss this analysis
        <Icon name="arrow-right" size={14} />
      </a>
    </div>
  </main>
</Layout>
