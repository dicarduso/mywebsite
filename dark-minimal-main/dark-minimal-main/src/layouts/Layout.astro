---
import '@fontsource/ubuntu/400.css'; 
import '@fontsource/ubuntu/700.css'; 

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title} | Portfolio</title>
    <meta
      name="description"
      content="Diogo Cardoso - Data Scientist graduate and Cyber Security enthusiast."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href="https://darkminimal.vercel.app/" />

    <meta
      property="og:title"
      content="Diogo Cardoso | Cyber Security"
    />
    <meta
      property="og:description"
      content="Website of Diogo Cardoso, a Data Scientist moving his area to Cyber Security."
    />
    <meta
      property="og:image"
      content="https://darkminimal.vercel.app/og.image.png"
    />
    <meta property="og:url" content="https://darkminimal.vercel.app" />
    <meta property="og:type" content="website" />
    <meta
      property="og:site_name"
      content="Diogo Cardoso's website"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Diogo Cardoso",
        "url": "https://darkminimal.vercel.app",
        "image": "https://darkminimal.vercel.app/og.image.png",
        "sameAs": [
          "https://github.com",
          "https://linkedin.com"
        ],
        "jobTitle": "Data Scientist & Cyber Security Enthusiast",
        "description": "Data Scientist graduate transitioning into Cyber Security."
      }
    </script>
  </head>
  <body class="bg-[--background] sm:px-28 lg:px-20 px-9">
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --background: #000000;
    --sec: #C93F14;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #610808c9;
    --white-icon-tr-button: #d60707e5;
  }

  html, body {
    cursor: url('/cursor-def.png') 0 0, auto !important;
  }

  a, button, [role="button"] { 
    cursor: url('/cursor-click.png') 0 0, pointer !important;
  }

  * {
    font-family:
      "Ubuntu",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  /* Scrollbar styles */

  ::-webkit-scrollbar {
    width: 15px;
  }

  ::-webkit-scrollbar-track {
    background: var(--background);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--sec);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--white);
  }

  /* Scrollbar styles for Firefox */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--sec) var(--background);
  }
</style>