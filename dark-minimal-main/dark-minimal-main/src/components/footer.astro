---
import LikeButton from "../React/LikeButton.tsx";

const currentYear = new Date().getFullYear();
const baseUrl = import.meta.env.BASE_URL;

<footer class="w-full py-12 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto flex flex-col items-center justify-center space-y-6">
    
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 py-2">
      <div class="flex items-center space-x-2">
        <span class="text-[var(--white-icon)] text-sm">Built with</span>
        <span class="text-[var(--white-icon)] text-sm font-medium">Astro</span>
      </div>

      <span class="hidden sm:inline text-[var(--white-icon-tr)]">•</span>

      <div class="flex items-center space-x-1.5 text-sm">
        <span class="text-[var(--white-icon)]">Template</span>
        <a
          href="https://github.com/Gothsec/dark-minimal"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#C93F14] hover:font-bold hover:brightness-125 transition-all duration-200 ease-in-out cursor-pointer"
        >
          dark-minimal
        </a>
      </div>
    </div>

  </div>
</footer>